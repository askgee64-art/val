# ==============================================================================
# VAL — AUTONOMOUS AI CORE ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file with live secrets to GitHub.
# ==============================================================================

# --- VAL Core & Environment ---
VAL_ENV=development                       # development | testing | production
VAL_DEBUG=true
VAL_API_HOST=0.0.0.0
VAL_API_PORT=8000
VAL_FOUNDER_TOKEN=val-founder-dev-token   # Secret token for Founder CLI and dashboard
VAL_FOUNDER_EMAIL=founder@val.local
VAL_FOUNDER_NAME="Founder"
VAL_FOUNDER_USER_ID=00000000-0000-4000-8000-000000000001
VAL_FOUNDER_ORG_ID=00000000-0000-4000-8000-000000000010

# --- Database & Persistence Layer (Hybrid: SQLite Local + Supabase Cloud) ---
# Set VAL_PERSISTENCE_MODE to "local" (SQLite only), "supabase" (Cloud only), or "hybrid" (Local-first with cloud sync)
VAL_PERSISTENCE_MODE=hybrid
VAL_DATABASE_URL=sqlite+aiosqlite:///data/val.db

# --- Supabase Cloud Configuration ---
# Required when VAL_PERSISTENCE_MODE is "supabase" or "hybrid"
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Kept on server only, never exposed to browser!
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_STORAGE_BUCKET=val-artifacts

# --- Vercel Web Dashboard ---
VERCEL_URL=https://val-dashboard.vercel.app
NEXT_PUBLIC_VAL_API_URL=http://localhost:8000/api/v1  # Points to local or authorized gateway

# --- Model Providers (Interchangeable Cascade) ---
# Primary Initial Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-1.5-flash    # gemini-1.5-flash | gemini-1.5-pro | gemini-2.0-flash

# Optional Alternative Providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VAL_DEFAULT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Local Model Runner (Ollama / Local Server)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3.2:1b

# Local Fallback Engine (Runs offline without any API keys)
VAL_ALLOW_LOCAL_FALLBACK=true

# --- Hardware & Quantization Policy ---
# Detected automatically by SystemInfo probe, or overridden manually:
VAL_MAX_RAM_MB=2048
VAL_MAX_VRAM_GB=0
VAL_PREFERRED_QUANTIZATION=INT4         # INT4 | INT8 | FP16 | BF16
VAL_AUTO_OFFLOAD_HEAVY_TO_CLOUD=true

# --- Safety & Autonomy Bounds ---
VAL_MAX_PLAN_STEPS=20
VAL_MAX_TOOL_CALLS_PER_TASK=30
VAL_CODE_SANDBOX_TIMEOUT_SECONDS=10
VAL_CODE_SANDBOX_MAX_OUTPUT_BYTES=100000
