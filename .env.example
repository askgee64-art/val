# ==============================================================================
# VAL — AUTONOMOUS AI OPERATING SYSTEM CONFIGURATION TEMPLATE
# Copy to .env and configure for your deployment target.
# NEVER commit .env with real credentials/tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT RUNTIME (Founder Laptop / Local Host)
# ------------------------------------------------------------------------------
VAL_ENV=development                       # development | testing | production
VAL_DEBUG=true
VAL_API_HOST=0.0.0.0
VAL_API_PORT=8000
VAL_DATABASE_URL=sqlite+aiosqlite:///data/val.db
VAL_PERSISTENCE_MODE=hybrid               # local | supabase | hybrid
VAL_FOUNDER_TOKEN=val-founder-dev-token   # Shared dev token for local verification
VAL_FOUNDER_NAME="Tomiwa"
VAL_FOUNDER_EMAIL=founder@val.local
VAL_FOUNDER_USER_ID=00000000-0000-4000-8000-000000000001
VAL_FOUNDER_ORG_ID=00000000-0000-4000-8000-000000000010

# ------------------------------------------------------------------------------
# 2. VERCEL PREVIEW ENVIRONMENT (Branches / PRs)
# ------------------------------------------------------------------------------
# In Vercel Project Settings -> Environment Variables (Environment: Preview)
# Vercel handles serverless execution with writable /tmp storage.
# Set NEXT_PUBLIC_VAL_API_URL or VAL_API_URL if routing to external gateway.
VAL_API_URL=/api/v1
VAL_ALLOW_LOCAL_FALLBACK=true

# ------------------------------------------------------------------------------
# 3. VERCEL PRODUCTION ENVIRONMENT (Production Branch: main)
# ------------------------------------------------------------------------------
# In Vercel Project Settings -> Environment Variables (Environment: Production)
VERCEL_ENV=production
VAL_ENV=production
# Production URL where Vercel serves the application
VERCEL_URL=https://val-dashboard.vercel.app

# ------------------------------------------------------------------------------
# 4. BACKEND RUNTIME & HARDWARE-AWARE MODEL ROUTER
# ------------------------------------------------------------------------------
VAL_DEFAULT_MODEL=gemini-1.5-flash
VAL_AUTO_OFFLOAD_HEAVY_TO_CLOUD=true
VAL_PREFERRED_QUANTIZATION=INT4         # INT4 | INT8 | FP16 | BF16
VAL_ALLOW_LOCAL_FALLBACK=true           # Runs deterministic safe engine when offline

# Safety & Permission Bounds
VAL_MAX_PLAN_STEPS=20
VAL_MAX_TOOL_CALLS_PER_TASK=30
VAL_CODE_SANDBOX_TIMEOUT_SECONDS=10
VAL_CODE_SANDBOX_MAX_OUTPUT_BYTES=100000

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI (Primary Initial Cloud Reasoning Provider)
# ------------------------------------------------------------------------------
# Required for full multi-step cloud reasoning cascade
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-1.5-flash    # gemini-1.5-flash | gemini-1.5-pro

# Optional alternative cloud providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 6. SUPABASE CLOUD PERSISTENCE (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Required when syncing laptop state to cloud database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key # Kept on server only!
SUPABASE_DB_URL=postgresql://postgres.your-project-id:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_STORAGE_BUCKET=val-artifacts
